# Copy this file to ~/.config/onlymygame/nas-deploy.env and keep the copy local.
# Configure the SSH key, host-key verification, and port in ~/.ssh/config.
NAS_DEPLOY_TARGET=onlymygame-nas
NAS_DEPLOY_PORT=3442
NAS_DEPLOY_PATH=/volume1/docker/OnlyMyGame
# Required: use the full registry image digest. Tags such as latest or a commit
# SHA are not production identities. Replace this deliberately; the placeholder
# is invalid so an unedited example fails closed.
NAS_API_IMAGE='ghcr.io/shinepcs/onlymygame-api@sha256:REPLACE_WITH_64_HEX_DIGEST'
# The deploy script also requires a GitHub artifact attestation issued by
# shinepcs/OnlyMyGame/.github/workflows/server-container.yml for this digest.
# The standalone binary must be Docker Compose v1.29.2+ or v2. The deploy script
# performs a capability/config preflight before it stops a running API.
NAS_DOCKER_COMPOSE_COMMAND=/usr/local/bin/docker-compose
NAS_DOCKER_COMMAND=/usr/local/bin/docker
# Optional platform overrides. GC never runs unless explicitly requested below.
NAS_STAT_COMMAND=/usr/bin/stat
NAS_ROLLBACK_KEEP=3
# Optional: omit this line when NAS_DEPLOY_TARGET uses an SSH key.
NAS_DEPLOY_PASSWORD_FILE=/absolute/path/to/sshpw.txt

# Rollback artifacts and SQLite backups are retained by default. Do not persist
# this switch in the config; set it to 1 only on an intentional retention-GC run.
# ONLYMYGAME_GC_ROLLBACKS=1
